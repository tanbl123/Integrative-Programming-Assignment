# NetBeans
#
# private/ is genuinely per-developer - it holds the local browser choice and
# absolute paths from whichever machine last opened the project. project.xml
# and project.properties are NOT: without both, the folder does not open as a
# NetBeans project at all, and the assignment requires the project itself to
# be submitted. They are tracked.
nbproject/private/
build/
dist/

# Local configuration (each developer has their own)
config/config.local.php

# Complaint photos.
#
# Normally user uploads are kept out of version control. They are tracked here
# on purpose: the demo database rows in complaint_attachments name files by
# their stored_name, so without the files themselves every teammate importing
# that data would see a broken image and think the module was faulty.
#
# The consequence is that any photo uploaded while testing will appear in
# git status. Commit the ones the demo data needs and leave the rest alone.

# Logs
*.log

# OS
Thumbs.db
.DS_Store
desktop.ini
